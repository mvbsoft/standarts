{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-bash.sh"], "timeout": 10, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "sh", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.sh"], "timeout": 180, "onFailure": "block", "statusMessage": "Checking the file in the dev container" }
        ]
      }
    ]
  }
}
