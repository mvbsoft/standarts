# project template 1.0.0 — a starting point: one comment line above every variable.
# Copy to .env. In dev, make bootstrap does it and fills PROJECT_DIR, HOST_UID, HOST_GID;
# on a server, copy it by hand and chmod 600 it (docs/how-to/operations.md). .env is never in git.
# On a server, replace every change-me: make stage and make prod refuse while one is left, and
# while other users of the machine can read .env.

# Which environment this clone runs: dev, stage or prod. make stage / make prod refuse elsewhere.
PROJECT_ENV=dev
# Set by make to the tree hash of the commit being deployed (git rev-parse <commit>^{tree});
# this value is only a placeholder for the compose check.
IMAGE_TAG=0000000000000000000000000000000000000000

# Dev only: make bootstrap fills them in a new .env; set them by hand in a .env that already
# exists.
PROJECT_DIR=
HOST_UID=
HOST_GID=
# Dev only: make bootstrap sets it in the new .env of a second copy (a git worktree, or make dev
# NAME=<n>).
DEV_SUFFIX=
# Host port of the application. Empty in a second copy: Docker picks a free one, make dev prints it.
APP_PORT=8000
# Mutation testing (the owner's choice): remove MUTATION_CPUS and MUTATION_MEM when the project
# does not use it (the MUTATION settings of the Makefile).
# Dev only: the CPUs of the make mutation container; set the mutation tool's worker count to fit them.
MUTATION_CPUS=2
# Dev only: the memory of the make mutation container (512m, 4g); all the tool's workers share it.
MUTATION_MEM=4g

# The password of the database superuser, which only the db and backup services use. Required,
# no default anywhere (standard PRN-04). Letters and digits only: docker compose expands a $ in
# .env (openssl rand -hex 32).
DB_PASSWORD=change-me
# The application's own database role: the application logs in with it and it owns what the
# migrations create; never the superuser. The db service creates it and keeps its password.
APP_DB_USER=app
# The password of that role. Required, no default anywhere. Letters and digits only: it is part
# of DATABASE_URL.
APP_DB_PASSWORD=change-me
# The application's log level (standard OPS-03): dev and stage may use debug, prod uses info or higher.
LOG_LEVEL=info
# Container limits of the application (standard OPS-02; how they are chosen: docs/how-to/tuning.md).
APP_CPUS=1
APP_MEM=512M
# Container limits of the database (docs/how-to/tuning.md).
DB_CPUS=1
DB_MEM=1G
# Stage and prod: PostgreSQL shared_buffers, derived from DB_MEM (docs/how-to/tuning.md). Sizes
# need a unit (256MB, not 32768).
DB_SHARED_BUFFERS=256MB
# Stage and prod: PostgreSQL effective_cache_size, derived from DB_MEM (docs/how-to/tuning.md),
# with a unit.
DB_EFFECTIVE_CACHE_SIZE=768MB

# Backups (standard OPS-01, docs/how-to/backups.md). The daily backup time, HH:MM in UTC.
BACKUP_TIME=03:00
# How many daily sets to keep (the newest of each day) on this server; the copy is rotated by
# its storage (docs/how-to/backups.md).
BACKUP_KEEP_DAILY=7
# How many weekly sets to keep (the newest of each ISO week) on this server; the copy is rotated
# by its storage.
BACKUP_KEEP_WEEKLY=4
# The day of the weekly restore drill, after that day's backup: 1 (Monday) to 7 (Sunday).
BACKUP_DRILL_DAY=7
# Stage and prod: the folder of the backup sets on this machine (never in git or in an image),
# one folder per environment and project, empty or missing at the first start; the service marks
# it as its own (.backup-folder) and refuses another non-empty folder, but one that holds only the
# sets an earlier version of the service left there. Dev keeps its test sets in the volume
# backup-data instead.
BACKUP_DIR=./docker/backup/data
# The off-server copy: a rest-server, rest:https://<host>:<port>/<login>/, on which this server
# can only write. Empty: no copy (in prod only with the owner's no in the registry: a copy on
# the same disk does not survive that disk).
BACKUP_COPY_TO=
# The password restic encrypts the copy with. Keep it in a safe place too: without it the copy
# cannot be read. Letters and digits only, like DB_PASSWORD.
BACKUP_COPY_PASSWORD=change-me
# The rest-server login of this server (never in BACKUP_COPY_TO, which the messages show).
BACKUP_COPY_LOGIN=
# The password of that login, needed only with a rest: copy; without one, none stays there
# (make check-compose wants every secret set, so it is never empty). Letters and digits only.
BACKUP_COPY_LOGIN_PASSWORD=none
# The certificate file of a rest-server with a certificate of its own, on this machine
# (/dev/null: none, the server's certificate is publicly trusted).
BACKUP_COPY_CACERT=/dev/null
# How much of the copy's data the weekly read check reads (10%), or 0: only its structure.
BACKUP_COPY_READ=10%
# The backup service turns unhealthy when the newest set, or copy, is older than this (s, m, h or d).
BACKUP_MAX_AGE=26h
# A webhook that receives a one-line POST about every backup failure. Empty: no notifications.
BACKUP_NOTIFY_URL=
# A monitor on another machine: a GET after each good daily run, an alert when one is missing. Empty: off.
BACKUP_HEARTBEAT_URL=
# The read-only database role the backups run as; the backup service creates it, keeps its rights
# and sets its password. Its own role, never the superuser (the backup refuses one).
BACKUP_DB_USER=backup
# The password of that role. Required, no default anywhere. Letters and digits only, like DB_PASSWORD.
BACKUP_DB_PASSWORD=change-me
# Container limits of the backup service; a drill runs a temporary database inside it.
BACKUP_CPUS=1
BACKUP_MEM=512M

# Free space kept on every disk the project writes to, on top of what a step needs (K, M, G or
# T, or 0). Before anything changes, a command warns and asks (without a terminal: refuses unless
# RISK=yes is on the make command line) when there is less: make stage, prod, images and (on a
# server) restore when the disk of Docker's images lacks two times the own images plus this (make
# rollback and restart: only the own images they must build); a deploy, rollback or restart when
# LOG_ARCHIVE_DIR lacks 30M per container it replaces plus this; make backup and restore when the
# backup folder lacks the new sets plus this; make backup-drill when its volume backup-drill lacks
# the size of the set plus this. The scheduled backup and drill refuse.
DISK_RESERVE=2G
# Stage and prod: the folder, relative to this clone or absolute, where make stage, prod,
# rollback and restart save the logs of every container they may replace, as
# <UTC time>-<service>.log; Docker removes a container's logs with it. Nothing removes old files
# here: the folder grows until you remove them. Empty: no archive.
LOG_ARCHIVE_DIR=.deploy/logs

# Stage and prod: the status service (docs/how-to/operations.md, "Monitoring"). GET /status
# answers only with Authorization: Bearer <STATUS_TOKEN>. Required, at least 16 characters
# (openssl rand -hex 32); the service refuses to start with a shorter one.
STATUS_TOKEN=change-me
# The port on 127.0.0.1 that the server's front proxy forwards https://<host>/status to.
STATUS_PORT=8090
# Every STATUS_PUSH_INTERVAL (60, 60s, 5m or 1h) the status service POSTs its JSON to
# STATUS_PUSH_URL while the status is pass or warn, and to STATUS_PUSH_FAIL_URL while it is fail.
# An empty address sends nothing: with STATUS_PUSH_FAIL_URL empty, a monitor that waits for pings
# alerts on the silence. A failed push is only logged. Both empty: no push (a monitor polls
# GET /status: 200 for pass or warn, 503 for fail).
STATUS_PUSH_URL=
STATUS_PUSH_FAIL_URL=
STATUS_PUSH_INTERVAL=60s
# The status service reports a disk unhealthy (status fail) below this free space: a percentage
# of the disk (10%) or a size (20G), never less than DISK_RESERVE; 0: DISK_RESERVE alone. A
# deploy needs more: two times the own images plus DISK_RESERVE. To be warned before a deploy
# warns about the space, set this above that sum for the disk of Docker's images.
DISK_WARN=10%
# The group that owns /var/run/docker.sock on this machine (stat -c %g /var/run/docker.sock);
# make bootstrap writes it into a new .env; every command that starts status-proxy refuses another
# (docs/how-to/operations.md, "When something fails"). The socket proxy of the status service runs
# as nobody in this group.
DOCKER_GID=999
# Container limits of the status service and of its socket proxy (measured: 21 MiB and 6 MiB in use).
STATUS_CPUS=0.25
STATUS_MEM=64M
STATUS_PROXY_CPUS=0.1
STATUS_PROXY_MEM=32M
