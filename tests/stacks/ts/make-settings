IMAGES = app
LINT = prettier --check src eslint.config.js && eslint --max-warnings 0 . && tsc && shellcheck .githooks/pre-push $$(find . -name '*.sh' -not -path './.git/*' -not -path './.claude/worktrees/*') && lychee --offline --no-progress .
TEST = vitest run
SECRETS = gitleaks dir --no-banner --no-color --redact -v .
FIX = prettier --write src eslint.config.js && eslint --fix .
